FROM docker.io/library/golang:1.27.1-alpine3.24 AS go
# Bootstrap image; the actual pinned Rust toolchain is installed below.
FROM docker.io/library/rust:1.85.0-alpine3.21
COPY --from=go /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}"
RUN apk add --no-cache bash build-base linux-headers cmake ninja curl git perl python3 \
    autoconf automake libtool pkgconf unzip patch gettext-dev gettext-static \
    ncurses-dev ncurses-static ncurses-terminfo libevent-dev libevent-static \
    pcre2-dev openssl-dev openssl-libs-static zlib-dev zlib-static
RUN apk add --no-cache bison
RUN rustup toolchain install 1.98.1 --profile minimal && rustup default 1.98.1
WORKDIR /work
