#!/bin/sh
export PATH=/opt/modern-linux/bin:/bin
export HOME=/root TERM=xterm-256color TERMINFO=/opt/modern-linux/share/terminfo
export XDG_CONFIG_HOME=/root/.config XDG_DATA_HOME=/root/.local/share
fail() {
    echo MODERN_LINUX_CENTOS7_FAIL
    poweroff -f
    sleep 1000
}
trap fail EXIT
set -eu
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
exec </dev/console >/dev/console 2>&1
mkdir -p /dev/pts /tmp /root/.config /root/.local/share
mount -t devpts devpts /dev/pts
uname -r | grep -q '^3\.10\.0-1160\.el7\.x86_64$'
uname -a
printf 'alpha\nbeta\n' >/tmp/input
while IFS= read -r tool <&3 || [ -n "$tool" ]; do
    tool=$(printf '%s\n' "$tool" | /bin/busybox sed 's/#.*//;s/^[[:space:]]*//;s/[[:space:]]*$//')
    case "$tool" in
    '') continue ;;
    tmux)
        tmux -V
        tmux -L smoke -f /dev/null new-session -d -s smoke '/bin/sleep 30'
        tmux -L smoke has-session -t smoke
        tmux -L smoke kill-server
        ;;
    neovim)
        nvim --version | /bin/busybox head -n 1
        nvim --headless -u NONE -i NONE -l /nvim-smoke.lua
        ;;
    fish)
        # shellcheck disable=SC2016 # Fish expands $n; the guest shell must not.
        fish --no-config -c 'test (math 2 + 3) = 5; and string match -q "a*" alpha; and set -l n (random 1 10); and test $n -ge 1; and test $n -le 10'
        ;;
    ripgrep) rg alpha /tmp/input ;;
    fd) fd --no-ignore input /tmp | grep -q input ;;
    fzf) fzf --filter=alpha </tmp/input | grep -q alpha ;;
    bat) bat --paging=never --color=never /tmp/input ;;
    eza)
        eza --version
        eza --color=never --oneline /tmp >/tmp/eza-output
        cat /tmp/eza-output
        grep -qx input /tmp/eza-output
        ;;
    delta)
        delta --version
        printf '%s\n' 'diff --git a/input b/input' '--- a/input' '+++ b/input' \
            '@@ -1 +1 @@' '-alpha' '+beta' >/tmp/input.diff
        delta --light --paging=never </tmp/input.diff >/tmp/delta-output
        grep -q beta /tmp/delta-output
        ;;
    procs)
        /bin/sleep 30 &
        probe_pid=$!
        procs --color disable --theme dark --pager disable >/tmp/procs-output
        cat /tmp/procs-output
        grep -Eq "^[[:space:]]*${probe_pid}[[:space:]]" /tmp/procs-output
        kill "$probe_pid"
        ;;
    zoxide)
        zoxide add /tmp
        zoxide query tmp
        ;;
    starship)
        starship --version
        starship init bash >/tmp/starship-init
        STARSHIP_SHELL=bash starship prompt --status 0 >/tmp/starship-prompt
        test -s /tmp/starship-prompt
        ;;
    mcfly)
        mcfly --version
        mcfly init bash >/tmp/mcfly-init
        : >/tmp/mcfly-history
        export MCFLY_SESSION_ID=centos7-smoke MCFLY_HISTORY=/tmp/mcfly-history
        export HISTFILE=/tmp/mcfly-history
        mcfly add --exit 0 --dir /tmp 'echo centos7-smoke'
        mcfly dump >/tmp/mcfly-dump
        grep -q 'echo centos7-smoke' /tmp/mcfly-dump
        ;;
    gdb)
        gdb --nx --batch -ex 'set startup-with-shell off' -ex 'break main' \
            -ex run -ex 'print argc' -ex continue /debug-smoke >/tmp/gdb-output 2>&1
        cat /tmp/gdb-output
        grep -q 'Breakpoint 1, main' /tmp/gdb-output
        grep -q 'exited normally' /tmp/gdb-output
        ;;
    cgdb)
        cgdb --version
        /cgdb-smoke
        ;;
    valgrind)
        valgrind --version
        valgrind --tool=memcheck --error-exitcode=97 --leak-check=full \
            /memory-smoke >/tmp/valgrind-clean 2>&1
        status=0
        valgrind --tool=memcheck --error-exitcode=97 \
            /memory-smoke invalid >/tmp/valgrind-invalid 2>&1 || status=$?
        cat /tmp/valgrind-clean /tmp/valgrind-invalid
        test "$status" -eq 97
        grep -q 'Invalid write of size 1' /tmp/valgrind-invalid
        ;;
    git)
        git --version
        git init /tmp/git-smoke
        git -C /tmp/git-smoke config user.name Smoke
        git -C /tmp/git-smoke config user.email smoke@example.invalid
        printf 'tracked\n' >/tmp/git-smoke/input
        git -C /tmp/git-smoke add input
        git -C /tmp/git-smoke commit -m smoke
        git clone --no-local /tmp/git-smoke /tmp/git-clone
        git -C /tmp/git-clone show HEAD:input | grep -qx tracked
        git -C /tmp/git-clone fsck
        ;;
    cmake)
        cmake --version
        mkdir -p /tmp/cmake-source
        cat >/tmp/cmake-source/CMakeLists.txt <<'CMAKE'
cmake_minimum_required(VERSION 3.20)
project(smoke NONE)
enable_testing()
add_test(NAME echo COMMAND "${CMAKE_COMMAND}" -E echo cmake-smoke)
set(CPACK_GENERATOR TGZ)
set(CPACK_INSTALL_CMAKE_PROJECTS "")
set(CPACK_INSTALLED_DIRECTORIES "${CMAKE_CURRENT_SOURCE_DIR};share/smoke")
include(CPack)
CMAKE
        cmake -S /tmp/cmake-source -B /tmp/cmake-build -DCMAKE_MAKE_PROGRAM=/bin/busybox
        ctest --test-dir /tmp/cmake-build --output-on-failure
        (cd /tmp/cmake-build && cpack -G TGZ)
        ;;
    *)
        echo "Unknown tool: $tool"
        exit 1
        ;;
    esac
    echo "PASS: $tool"
done 3</opt/modern-linux/list.txt
echo MODERN_LINUX_CENTOS7_PASS
trap - EXIT
poweroff -f
sleep 1000
